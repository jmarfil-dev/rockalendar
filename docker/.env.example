
# ---- Base de datos ----
DB_PASSWORD=cambia_esto

# ---- JWT ----
JWT_SECRET=cambia_esto_minimo_32_caracteres_aleatorios

# ---- Proxy inverso (IP de Traefik/Coolify dentro de la red Docker) ----
# Consultar con: docker inspect <traefik-container> | grep IPAddress
IP_PROXY=172.17.0.0/16

# ---- MinIO ----
MINIO_ROOT_USER=cambia_esto
MINIO_ROOT_PASSWORD=cambia_esto

# URL pública desde la que los navegadores cargan las imágenes.
# Ejemplo: https://storage.rockalendar.es/rockalendar
STORAGE_PUBLIC_URL_BASE=https://storage.rockalendar.es/rockalendar

# ---- Email transaccional (Brevo) ----
# Credenciales SMTP: Brevo → SMTP & API → SMTP
BREVO_SMTP_USER=usuario@rockalendar.es
BREVO_SMTP_PASSWORD=clave_smtp_de_brevo
EMAIL_FROM=noreply@rockalendar.es

# ---- Frontend ----
FRONTEND_BASE_URL=https://rockalendar.es

# URL del backend tal como la ve el navegador del usuario (no el contenedor)
NUXT_PUBLIC_API_BASE=https://rockalendar.es/api
